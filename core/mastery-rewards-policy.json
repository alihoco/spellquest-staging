{
  "product_name": "Spellmaster",
  "name_previous": "SpellQuest",
  "version": "1.1.0",
  "status": "design policy; educational and psychological review pending",
  "motto": "Better today than yesterday",
  "never_compare_with_peers": true,
  "skill_statuses": [
    {
      "id": "discoverer",
      "evidence": "concept introduced and explored",
      "counts_as_independent_mastery": false
    },
    {
      "id": "builder",
      "evidence": "supported construction or recognition with recorded aid",
      "counts_as_independent_mastery": false
    },
    {
      "id": "independent_speller",
      "evidence": "correctly produces spelling unaided after instruction",
      "counts_as_independent_mastery": false
    },
    {
      "id": "master",
      "evidence": "delayed independent recall across validated examples",
      "counts_as_independent_mastery": true
    },
    {
      "id": "enduring_master",
      "evidence": "later delayed retention and appropriate transfer",
      "counts_as_independent_mastery": true
    }
  ],
  "reward_policy": {
    "allow": [
      "optional coins",
      "story progress",
      "private trophies",
      "realm unlocks",
      "personal bests",
      "positive pattern-based feedback"
    ],
    "disallow": [
      "class rankings",
      "global leaderboards",
      "age norm shame",
      "speed-only mastery",
      "streak loss",
      "trophy revocation for forgetfulness",
      "mastery from assisted tiles or multiple-choice"
    ],
    "refresh_when_forgotten": true,
    "age_independent_skill_titles": true,
    "age_respectful_visual_theme": true
  },
  "scope": "Skill- or pattern-specific mastery; no global terminal maximum level",
  "measurement": "Delayed unaided spelling, not practice points",
  "research_validated_thresholds": false,
  "psychological_safety": {
    "standard": "research/PSYCHOLOGICAL_SAFETY_AND_FEEDBACK_V1.md",
    "no_failure_labels": true,
    "truthful_specific_feedback": true,
    "no_shaming_sounds_or_red_crosses": true,
    "no_forced_retries": true,
    "offer_pause_skip_and_support": true,
    "never_revoke_mastery_trophies": true,
    "do_not_invent_positive_outcomes": true,
    "all_feedback_requires_review": true
  },
  "proportionate_recognition": {
    "principle": "Small authentic achievements receive small recognition; significant demonstrated retained mastery earns significant, occasional rewards.",
    "praise_requires_observable_basis": true,
    "never_reward_merely_for_clicks": true,
    "minor": {
      "events": [
        "specific corrected letter pattern",
        "successful independent self-correction"
      ],
      "tone": "warm, specific, understated",
      "reward": "small optional progress acknowledgement"
    },
    "moderate": {
      "events": [
        "correct immediate independent recall"
      ],
      "tone": "recognise independent work without mastery claim",
      "reward": "measured progress"
    },
    "major": {
      "events": [
        "delayed independent retained mastery across appropriate examples",
        "relevant transfer demonstrated"
      ],
      "tone": "occasional meaningful celebration",
      "reward": "master badge or realm unlock"
    },
    "after_error": {
      "tone": "neutral, kind, actionable; no criticism or fabricated praise",
      "reward": "none for incorrect answer; help available without cost"
    },
    "preferences": [
      "quiet feedback",
      "reduced animations",
      "age-respectful reward styling"
    ],
    "anti_patterns": [
      "confetti on every tap",
      "praise with no observation",
      "easy-question reward farming",
      "loss aversion",
      "mastery credit for assisted recognition"
    ],
    "thresholds_validated": false
  }
}
