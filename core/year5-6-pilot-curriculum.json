{
  "version": "1.0.0",
  "date": "2026-11-11",
  "status": "curriculum word selection verified; sequence provisional pending specialist review",
  "source": "https://www.gov.uk/government/uploads/system/uploads/attachment_data/file/239784/English_Appendix_1_-_Spelling.pdf",
  "locale": "en-GB",
  "total_seed_words": 30,
  "pilot_plan": "Ten weeks of three new words each, plus two weeks with no new words for consolidation; paced by baseline knowledge, not school age.",
  "sequencing_rationale": "Teach one clearly defined feature with contrasted words, then interleave retrieval with previously taught features; do not assume all words in a cluster obey the same rule.",
  "scheduling_hypothesis": {
    "new_words_per_week_default": 3,
    "baseline_check_before_teaching": true,
    "first_review_days": [
      1,
      3,
      7,
      14,
      28
    ],
    "after_miss": "targeted_teaching_then_new_independent_attempt; reset review interval as needed",
    "carry_due_reviews_across_weeks": true,
    "max_practice_minutes_suggestion": 10,
    "delays_are_unvalidated": true
  },
  "assessment": {
    "weekly": "brief mixed independent spoken dictation, not same-cluster-only",
    "monthly": "mixed mastered and tricky words plus one untrained transfer word where valid",
    "end_of_pilot": "retained independent spelling of all selected words, spaced test; confidence and usability"
  },
  "weekly_groups": [
    {
      "week": 1,
      "cluster_id": "double_letters_intro",
      "introduce": [
        "necessary",
        "embarrass",
        "harass"
      ],
      "teacher_review_focus": "Compare consonant counts, no universal doubling rule",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 2,
      "cluster_id": "double_letters_contrast",
      "introduce": [
        "accommodate",
        "aggressive",
        "recommend"
      ],
      "teacher_review_focus": "Contrasting c/m/g doubling and doubled consonants",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 3,
      "cluster_id": "suffix_ment",
      "introduce": [
        "government",
        "environment",
        "equipment"
      ],
      "teacher_review_focus": "Base word and suffix -ment; equipment comes from equip",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 4,
      "cluster_id": "unstressed_vowels",
      "introduce": [
        "definite",
        "desperate",
        "familiar"
      ],
      "teacher_review_focus": "Unstressed vowel spelling, verified related words when applicable",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 5,
      "cluster_id": "meaningful_families",
      "introduce": [
        "communicate",
        "community",
        "correspond"
      ],
      "teacher_review_focus": "Communicate/community relationship; correspond analysed independently",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 6,
      "cluster_id": "scientific_spellings",
      "introduce": [
        "conscience",
        "conscious",
        "sufficient"
      ],
      "teacher_review_focus": "Contrast sci/ci sequences with validated pronunciation and morphology",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 7,
      "cluster_id": "vowel_choices",
      "introduce": [
        "foreign",
        "neighbour",
        "leisure"
      ],
      "teacher_review_focus": "Different, largely word-specific vowel spellings, not one shared rule",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 8,
      "cluster_id": "rh_ph",
      "introduce": [
        "rhythm",
        "rhyme",
        "physical"
      ],
      "teacher_review_focus": "rh spellings; ph in physical is a separate contrast",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 9,
      "cluster_id": "tricky_suffixes",
      "introduce": [
        "pronunciation",
        "profession",
        "privilege"
      ],
      "teacher_review_focus": "Separate verified suffix/word-family patterns",
      "rule_status": "requires word-specific validation"
    },
    {
      "week": 10,
      "cluster_id": "unstressed_multisyllable",
      "introduce": [
        "temperature",
        "vegetable",
        "mischievous"
      ],
      "teacher_review_focus": "Reduced syllables and unstressed letters; verified spoken form only",
      "rule_status": "requires word-specific validation"
    }
  ],
  "consolidation": [
    {
      "week": 11,
      "activities": "No new words; mixed deferred reviews and error-targeted teaching"
    },
    {
      "week": 12,
      "activities": "Cumulative independently spelled mixed review and learner reflections"
    }
  ],
